generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  INVESTOR
}

enum TransactionType {
  ADMIN_CREDIT
  INVESTMENT
  PAYOUT
}

enum CompanyStatus {
  OPEN
  CLOSED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(INVESTOR)
  avatarUrl    String?
  interestRate Decimal  @default(0) @db.Decimal(6, 2)
  createdAt    DateTime @default(now())

  transactions      WalletTransaction[] @relation("UserTransactions")
  createdTransactions WalletTransaction[] @relation("AdminCreatedTransactions")
  investments       Investment[]
  companiesCreated  Company[]
  investmentRequests        InvestmentRequest[] @relation("UserRequests")
  resolvedInvestmentRequests InvestmentRequest[] @relation("ResolvedRequests")
}

model Company {
  id             String        @id @default(cuid())
  name           String
  description    String
  sector         String?
  status         CompanyStatus @default(OPEN)
  currentValue   Decimal       @default(0) @db.Decimal(14, 2)
  initialValue   Decimal       @default(0) @db.Decimal(14, 2)
  historicalData Json          @default("[]")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  investments        Investment[]
  investmentRequests InvestmentRequest[]
}

model InvestmentRequest {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(14, 2)
  note      String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  resolvedAt DateTime?

  userId String
  user   User   @relation("UserRequests", fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  resolvedById String?
  resolvedBy   User?   @relation("ResolvedRequests", fields: [resolvedById], references: [id])
}

model Investment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  note      String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
}

model WalletTransaction {
  id        String          @id @default(cuid())
  amount    Decimal         @db.Decimal(14, 2)
  type      TransactionType
  note      String?
  createdAt DateTime        @default(now())

  userId String
  user   User   @relation("UserTransactions", fields: [userId], references: [id])

  createdById String
  createdBy   User   @relation("AdminCreatedTransactions", fields: [createdById], references: [id])
}
